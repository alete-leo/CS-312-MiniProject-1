<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Blog</title>
  </head>


  <body>
    <% if (locals.numberOfLetters) { %>
    <h1>There are <%= numberOfLetters %> blog posts here.</h1>
    <% } else { %>
    
    <% } %>
    <h1>Create a post to this blog!</h1>
    <form action="/submit" method="POST">
        <div id="inputForm">
            <input type="text" name="fName" placeholder="Blog Title" />
            <input type="text" name="lName" placeholder="Your Name" />
            <p>
                <input type="text" name="blogDate" placeholder="Creation Date: <%= new Date().toDateString() %>" /> <!-- disable this & input the date -->
            </p>
            <p>
                <input type="text" name="blogContent" placeholder="Enter Your Blog Here" />
            </p>
      
            <p></p>
            <input type="submit" value="OK" />
        </div>
      
    </form>
  </body>
</html>

